# ContainBench Production Environment Configuration for Vultr VM

# API key securing the backend endpoints
CONTAINBENCH_API_KEY=containbench-vultr-secret-2026

# Vultr Serverless Inference API Key (leave blank or provide if you have one)
VULTR_API_KEY=

# Default inference model for crash-test explanations
DEFAULT_MODEL=auto

# Frontend Basic Auth protection for public IP demo
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=containbench

# Backend port & execution mode
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
EXECUTION_MODE=docker
DOCKER_SANDBOX_IMAGE=containbench-agent-sandbox:latest
DOCKER_SANDBOX_NETWORK=containbench-sandbox
RECEPTOR_QUERY_URL=http://mock-receptor.local:8080
