# ContainBench Production Environment Configuration Template
# Copy this file to .env and replace the placeholders with your own secure values:
#   cp .env.example .env

# API key securing the backend endpoints (generate with: openssl rand -hex 24)
CONTAINBENCH_API_KEY=your_custom_random_api_key_here

# Vultr Serverless Inference API Key (optional - get from Vultr Console -> Serverless Inference)
VULTR_API_KEY=

# Default inference model for crash-test explanations
DEFAULT_MODEL=auto

# Frontend Basic Auth protection for public IP demo
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=your_strong_password_here

# Backend port & execution mode
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
EXECUTION_MODE=docker
DOCKER_SANDBOX_IMAGE=containbench-agent-sandbox:latest
DOCKER_SANDBOX_NETWORK=containbench-sandbox
RECEPTOR_QUERY_URL=http://mock-receptor.local:8080
