# Ephemeral Agent Sandbox Image for ContainBench
# Designed for safe, non-privileged, observable execution on Vultr VMs

FROM python:3.11-slim

# Minimal networking and debugging utilities.
# util-linux provides setpriv, used to drop from root to the agent user after
# the decoy secret has been provisioned.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    iproute2 \
    procps \
    util-linux \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Restricted non-root user that runs the agent (uid 1001, see backend/app/runners/docker_runner.py)
RUN groupadd -g 1001 sandboxgroup && \
    useradd -u 1001 -g sandboxgroup -m -s /bin/bash sandboxuser

# Mount points. At run time both are replaced by tmpfs volumes:
# /workspace is owned by the agent, /secrets is provisioned by root.
RUN mkdir -p /workspace /secrets && \
    chown -R sandboxuser:sandboxgroup /workspace && \
    chmod 700 /secrets

WORKDIR /workspace
USER sandboxuser

# Default fallback command
CMD ["python3", "-c", "print('ContainBench Agent Sandbox ready.')"]
