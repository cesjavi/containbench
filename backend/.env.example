# ContainBench Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Vultr Serverless Inference
VULTR_API_KEY=your_vultr_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
DEFAULT_MODEL=llama2-70b-chat # Or meta/llama-3.1-70b-instruct / mistral-7b

# Sandbox Execution Mode: 'auto', 'docker', or 'simulator'
# 'auto': uses Docker if daemon is available, otherwise falls back to simulator
EXECUTION_MODE=auto

# Docker Configuration (for Vultr Linux VM)
DOCKER_SANDBOX_IMAGE=containbench-agent-sandbox:latest
CONTAINER_TIMEOUT_SECONDS=60

