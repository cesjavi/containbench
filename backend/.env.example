# ContainBench Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Vultr Serverless Inference
VULTR_API_KEY=your_vultr_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# "auto" picks the best available model from Vultr's catalog; or pin an id.
DEFAULT_MODEL=auto
MODEL_PREFERENCE=llama-3.3,llama-3.1-70b,llama-3.1,llama-3,qwen,mixtral,mistral

# Sandbox Execution Mode: 'auto', 'docker', or 'simulator'
# 'auto': uses Docker if the daemon is available, otherwise falls back to the simulator
EXECUTION_MODE=auto

# Docker configuration (for the Vultr Linux VM)
DOCKER_SANDBOX_IMAGE=containbench-agent-sandbox:latest
CONTAINER_TIMEOUT_SECONDS=60
# Network shared by permissive sandboxes and the mock receptor
DOCKER_SANDBOX_NETWORK=containbench-net
# URL the backend uses to query the mock receptor (http://localhost:8080 outside Compose)
RECEPTOR_QUERY_URL=http://mock-receptor.local:8080

# Storage
# SQLite file for runs and approvals (":memory:" keeps nothing on disk)
DATABASE_PATH=data/containbench.db

# Security
# Required X-API-Key header on /api routes (empty disables it; local development only).
# For the Vite dev server, set CONTAINBENCH_API_KEY to the same value before `npm run dev`.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HMAC secret for human approval tokens (empty = random per process)
APPROVAL_SECRET=
MAX_CONCURRENT_RUNS=2
# Hostnames allowed as agent_endpoint, comma-separated (empty = any host)
AGENT_ALLOWED_HOSTS=
